Windows Registry Editor Version 5.00

; PhoenixOS - Windows 11 TPM 2.0 Bypass
; This registry file bypasses the TPM 2.0 requirement during Windows 11 installation.
; Apply this during OOBE (Out of Box Experience) by pressing Shift+F10 to open Command Prompt,
; then running: reg import windows-tpm-bypass.reg

[HKEY_LOCAL_MACHINE\SYSTEM\Setup\LabConfig]
"BypassTPMCheck"=dword:00000001
"BypassSecureBootCheck"=dword:00000001
"BypassRAMCheck"=dword:00000001
"BypassCPUCheck"=dword:00000001
"BypassStorageCheck"=dword:00000001
